# Baseline configuration for the 4.19 port
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_PSTORE_SCREEN=y
CONFIG_PSTORE_SCREEN_DISPLAY=y
CONFIG_PSTORE_SCREEN_LOG_CAPTURE=y
CONFIG_PSTORE_SCREEN_PSTORE_MIRROR=y
CONFIG_PSTORE_SCREEN_PANIC=y
CONFIG_LOG_BUF_SHIFT=19

# Optional and NOT enabled by the generic 4.19 port:
# CONFIG_PSTORE_SCREEN_DRM_SIDECAR=y
# CONFIG_PSTORE_SCREEN_LOG_QR=y
